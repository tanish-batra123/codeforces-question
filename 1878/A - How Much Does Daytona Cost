#include <bits/stdc++.h>
using namespace std;
 
string solve(){
     int n,k;
    cin>>n>>k;
    vector<int>arr;
    for(int i=0;i<n;i++){
        int ele;
        cin>>ele;
        arr.push_back(ele);
    }
    for(int i=0;i<n;i++){
        if(arr[i]==k)return "YES";
    }
    return "NO";
}
 
int main(){
     int t;
    cin>>t;
    while(t--){
        cout<<solve()<<endl;
    }
    return 0;
}