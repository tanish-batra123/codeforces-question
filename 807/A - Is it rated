#include <bits/stdc++.h>
using namespace std;
 
void solve(){
    int n;
    cin>>n;
    vector<vector<int>>arr(n,vector<int>(2));
    for(int i=0;i<n;i++){
        int a,b;
        cin>>a>>b;
        arr[i][0]=a;
        arr[i][1]=b;
    }
    
 
   for(auto temp:arr){
    if(temp[0]!=temp[1]){
        cout<<"rated"<<endl;
        return;
    }
   }
 
   for(int i=1;i<n;i++){
    if(arr[i-1][0]<arr[i][0]){
        cout<<"unrated";
        return;
    }
 
 
   }
 
    cout<<"maybe"<<endl;
    
}
int main(){
    solve();
    return 0;
}